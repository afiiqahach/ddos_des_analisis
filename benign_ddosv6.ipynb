   "source": [
    "# Frekuensi pasangan Source–Destination IP\n",
    "ip_count = (\n",
    "    df.groupby(['Source', 'Destination', 'Label'])\n",
    "      .size()\n",
    "      .reset_index(name='Count')\n",
    "      .sort_values('Count', ascending=False)\n",
    ")\n",
    "display(ip_count)"
   ]
  },
