   "source": [
    "# Urutkan berdasarkan waktu\n",
    "df_benign = df_benign.sort_values('Time')\n",
    "\n",
    "# Hitung interarrival time (detik)\n",
    "df_benign['Interarrival'] = df_benign['Time'].diff().dt.total_seconds().fillna(0)\n",
    "\n",
    "# Hitung jumlah data paer pasangan Source–Destination\n",
    "top_pair = (\n",
    "    df_benign\n",
    "    .groupby(['Source', 'Destination'])\n",
    "    .size()\n",
    "    .reset_index(name='Interarrival_Count')\n",
    "    .sort_values('Interarrival_Count', ascending=False)\n",
    "    .head(1)\n",
    ")\n",
    "\n",
    "print(\" pasangan Source–Destination dengan data terbanyak:\")\n",
    "display(top_pair)\n",
    "\n",
    "# Ambil hanya data dari  pasangan teratas\n",
    "df_benign_top = df_benign.merge(\n",
    "    top_pair[['Source', 'Destination']],\n",
    "    on=['Source', 'Destination'],\n",
    "    how='inner'\n",
    ")\n",
    "\n",
    "print(\"Interarrival time untuk  pasangan Source–Destination dengan data terbanyak:\")\n",
    "display(\n",
    "    df_benign_top[['Source', 'Destination', 'Time', 'Interarrival', 'Label']]\n",
    ")"
   ]
  },
